# Google Gemini models via OpenRouter only (server-side)
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.7-flash
# Neon pooled connection string (server-side)
DATABASE_URL=
# Google Maps JavaScript API key (browser key; restrict by HTTP referrer)
GOOGLE_MAPS_API_KEY=
# Resend (applicant emails)
RESEND_API_KEY=
EMAIL_FROM=
